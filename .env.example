# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Get from @BotFather on Telegram
BOT_TOKEN=your-bot-token-here

# Your Telegram user IDs (comma-separated)
# Get your ID from @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Idle timeout for caffeinate (hours)
# Bot keeps Mac awake only when there's been activity within this time
# After timeout, Mac can sleep. Default: 24
# Can override with: ./start.sh -s HOURS
IDLE_TIMEOUT_HOURS=6

# Claude CLI binary path
# Path to directory containing claude executable
# Default: ~/.local/bin (standard installation location)
CLAUDE_BIN_PATH=$HOME/.local/bin

# ── Second bot: one supergroup, one topic per session (optional) ──────────────
# Leave blank to run with the direct chat alone.
#
# This must be a DIFFERENT bot from BOT_TOKEN. Telegram serves getUpdates to one
# consumer per token, so pointing both at the same bot makes the two poll loops
# fight and both get 409s.
#
# The bot needs to be an admin of the group with "Manage Topics", and Group
# Privacy turned off (@BotFather → /mybots → Bot Settings → Group Privacy), or it
# only receives messages that begin with a slash.
GROUP_BOT_TOKEN=

# The supergroup it lives in, e.g. -1001234567890. `node setup.js` detects this;
# by hand, it is the chat id in any update from that group.
GROUP_CHAT_ID=

# ── Optional ──────────────────────────────────────────────────────────────────
# A session /resume_pinned falls back to. Nothing is pinned unless set here or
# with /pin in the bot.
PINNED_SESSION_ID=
PINNED_SESSION_PATH=

# ── Voice notes in ────────────────────────────────────────────────────────────
# Send the bot a voice message and it is transcribed locally and treated exactly
# like a typed one. Needs `pip install faster-whisper` and ffmpeg on PATH; the
# model downloads itself on first use. Nothing leaves the machine.
#
# Whichever python has faster-whisper installed. Defaults to `python` on Windows
# and `python3` elsewhere.
STT_PYTHON=
# tiny | base | small | medium | large-v3. It runs on a CUDA card if it finds one
# and on the CPU otherwise, so pick by what the host has: medium is the sweet spot
# for Hebrew on a GPU, small is the one that stays usable on CPU alone, large-v3 is
# the most accurate and roughly three times slower than medium.
STT_MODEL=medium
# Spoken language of your voice notes.
STT_LANG=he
# Load the model when the bot starts instead of on the first voice note. Holds its
# memory permanently and saves the one-time warmup — which is seconds on CPU but
# can be half a minute on a cold GPU. Worth it if you dictate while driving.
STT_PRELOAD=0
# Drop the model after this many idle minutes. 0 keeps it loaded forever.
STT_IDLE_MINUTES=20
