# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Get from @BotFather on Telegram
BOT_TOKEN=your-bot-token-here

# Your Telegram user IDs (comma-separated)
# Get your ID from @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Idle timeout for caffeinate (hours)
# Bot keeps Mac awake only when there's been activity within this time
# After timeout, Mac can sleep. Default: 24
# Can override with: ./start.sh -s HOURS
IDLE_TIMEOUT_HOURS=6

# Claude CLI binary path
# Path to directory containing claude executable
# Default: ~/.local/bin (standard installation location)
CLAUDE_BIN_PATH=$HOME/.local/bin
