# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Get from @BotFather on Telegram
BOT_TOKEN=your-bot-token-here

# Your Telegram user IDs (comma-separated)
# Get your ID from @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Idle timeout for caffeinate (hours)
# Bot keeps Mac awake only when there's been activity within this time
# After timeout, Mac can sleep. Default: 24
# Can override with: ./start.sh -s HOURS
IDLE_TIMEOUT_HOURS=6

# Claude CLI binary path
# Path to directory containing claude executable
# Default: ~/.local/bin (standard installation location)
CLAUDE_BIN_PATH=$HOME/.local/bin

# ── Second bot: one supergroup, one topic per session (optional) ──────────────
# Leave blank to run with the direct chat alone.
#
# This must be a DIFFERENT bot from BOT_TOKEN. Telegram serves getUpdates to one
# consumer per token, so pointing both at the same bot makes the two poll loops
# fight and both get 409s.
#
# The bot needs to be an admin of the group with "Manage Topics", and Group
# Privacy turned off (@BotFather → /mybots → Bot Settings → Group Privacy), or it
# only receives messages that begin with a slash.
GROUP_BOT_TOKEN=

# The supergroup it lives in, e.g. -1001234567890. `node setup.js` detects this;
# by hand, it is the chat id in any update from that group.
#
# Worth setting even on a machine that only sends. scripts/move-to-telegram.js can
# read the group back out of a topic it has handled before, but that history is
# local — on a second machine there is none, no group is found, and every session
# goes quietly to the direct chat instead of a topic.
GROUP_CHAT_ID=

# Hold the group token without listening on it. Set this on every machine except
# the one that actually answers in the group.
#
# Telegram serves getUpdates to one consumer per token, so a second machine that
# copies this file verbatim starts a second poll loop and the two fight until both
# get 409s — the working bot on the first machine breaks because somebody set up a
# laptop. With this on, nothing here claims the group, and
# scripts/move-to-telegram.js can still push a session from this machine into a
# topic: it talks to the API over plain HTTPS and never polls.
GROUP_BOT_SEND_ONLY=

# ── More than one machine (optional) ─────────────────────────────────────────
# Skip all three if the bot only ever runs on one computer. Every default below is
# "this machine", which is what one machine means.
#
# With two, each topic is pinned to the machine that should answer it, and a session
# moved in from the other arrives as a Resume button that can actually work — its
# transcript is on a machine this one can reach.

# What THIS machine is called. A label on buttons and in lists, so make it readable:
# nobody picks a machine off "DESKTOP-4F7K2Q1". Defaults to "windows" or "mac".
HOST_NAME=

# The others, as name=ssh-destination, comma separated. ssh because the thing being
# asked for is "run this over there", and ssh is the answer that needs no daemon.
#   REMOTE_HOSTS=mac=you@studio.local,laptop=you@192.168.1.40
REMOTE_HOSTS=

# Which machine picks up a topic that was never bound to one.
#
# This has to read the SAME on every machine. Both poll their own group bot, both see
# every message in the shared group, and without an agreed fallback both claim every
# unbound topic and answer it twice. Empty means this machine — correct for a single
# box, and the thing a second machine must never be left on by accident.
GROUP_FALLBACK_HOST=

# ── Espresso machine (very optional) ─────────────────────────────────────────
# A control panel for a GaggiMate espresso machine on your LAN: shot temperature,
# steam, flush, the wake-up schedule.
#
# Leave this empty unless you own one. Empty means the feature does not exist —
# no /gm command, no row in the menu, nothing listening. It is not a stub to fill
# in later; it is off because almost nobody has the hardware.
#
# With it set, the panel can still be put away per chat without touching this file:
# say "גאג'ימייט כבוי" / "gaggimate off" to the bot, and "gaggimate on" to bring it
# back.
GAGGIMATE_HOST=

# ── Optional ──────────────────────────────────────────────────────────────────
# A session /resume_pinned falls back to. Nothing is pinned unless set here or
# with /pin in the bot.
PINNED_SESSION_ID=
PINNED_SESSION_PATH=

# ── Voice notes in ────────────────────────────────────────────────────────────
# Send the bot a voice message and it is transcribed locally and treated exactly
# like a typed one. Nothing leaves the machine.
#
# OFF by default, and turned on per chat from the settings panel — it is the only
# feature here that needs anything outside npm, so nobody installing this to talk
# to Claude from their phone is made to fetch a python package and a gigabyte of
# model weights they never asked for. Switching it on checks the host first and
# names what is missing. It needs `pip install faster-whisper` and ffmpeg on PATH;
# the model downloads itself on first use.
#
# The settings below only matter once somebody turns it on.
#
# Whichever python has faster-whisper installed. Defaults to `python` on Windows
# and `python3` elsewhere.
STT_PYTHON=
# tiny | base | small | medium | large-v3. It runs on a CUDA card if it finds one
# and on the CPU otherwise, so pick by what the host has: medium is the sweet spot
# for Hebrew on a GPU, small is the one that stays usable on CPU alone, large-v3 is
# the most accurate and roughly three times slower than medium.
STT_MODEL=medium
# Spoken language of your voice notes.
STT_LANG=he
# Load the model when the bot starts instead of on the first voice note. Holds its
# memory permanently and saves the one-time warmup — which is seconds on CPU but
# can be half a minute on a cold GPU. Worth it if you dictate while driving.
STT_PRELOAD=0
# Drop the model after this many idle minutes. 0 keeps it loaded forever.
STT_IDLE_MINUTES=20

# ── Topic workspaces ─────────────────────────────────────────────────────────
# Base folder for new topic sessions. Each topic gets its own subfolder here, since
# Claude keeps session history per folder — two topics sharing a folder share a
# history and answer into each other. Set per machine; empty means
# ~/claudegram-topics. Topics created earlier keep the folder already stored for them.
CLAUDEGRAM_CHATS_DIR=
