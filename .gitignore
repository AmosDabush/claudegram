# Environment and secrets
#
# Everything beginning with .env, not just .env itself. setup.js backs the old file up
# as .env.backup.<timestamp> before overwriting it, and that name matched none of the
# patterns here — so running setup twice and then `git add -A` would commit a file with
# both bot tokens in it. The one file that must stay tracked is the example, which has
# no values in it.
.env
.env.*
*.env
*.env.local
!.env.example

# Session data (contains user info)
sessions.json

# Backup files
*.backup

# Logs
*.log
bot.log

# Runtime
bot.pid
data/restart-notify.txt

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temp files
*.tmp
temp_audio_*.mp3
temp_audio_*.wav

# User data (contains personal info)
data/
!data/.gitkeep

# Local backup snapshots
*.bak
*.bak-*

# Working snapshots / build junk
*.pre-*
*.with-status-*
__pycache__/

# QA harness scratch state (scripts/qa.js)
data-qa/
